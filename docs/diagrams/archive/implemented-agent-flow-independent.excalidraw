      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 19,
      "fontFamily": 1,
      "text": "flash → quick; direct → review-worker.\nswarm → coordinator + justified specialists.\nswarm-smart/full → separate verifier; full → live-validator with bounded approval.\nWorkflow: full plan + base→head and task-owned staged, unstaged,\nuntracked changes; report inspected revisions. No fixer.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "flash → quick; direct → review-worker.\nswarm → coordinator + justified specialists.\nswarm-smart/full → separate verifier; full → live-validator with bounded approval.\nWorkflow: full plan + base→head and task-owned staged, unstaged,\nuntracked changes; report inspected revisions. No fixer.",
      "autoResize": false,
      "lineHeight": 1.3
    },
