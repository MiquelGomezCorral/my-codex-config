{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=\"${CODEX_HOME:-$HOME/.codex}/bin/codex-command-dispatch.mjs\"; [ -f \"$script\" ] || script=\"$HOME/.codex/bin/codex-command-dispatch.mjs\"; node \"$script\"",
            "statusMessage": "Loading repository command"
          }
        ]
      }
    ]
  }
}
