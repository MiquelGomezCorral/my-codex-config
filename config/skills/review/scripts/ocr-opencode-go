#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'ocr-opencode-go: %s\n' "$1" >&2
  exit 1
}

# The allowlist's owner is config/pi/extensions/opencode-go-models.ts; keep these ids in sync.
ocr_model=${OCR_OPENCODE_GO_MODEL:-deepseek-v4.1-flash}
case "$ocr_model" in
  deepseek-v4.1-flash|glm-5.3-flash) ;;
  *) die "model $ocr_model is not allowed on OpenCode Go (allowed: deepseek-v4.1-flash, glm-5.3-flash); see config/pi/extensions/opencode-go-models.ts" ;;
esac

command -v ocr >/dev/null 2>&1 || die "ocr is not installed"

opencode_go_token=${OPENCODE_API_KEY:-}
if [[ -z "$opencode_go_token" ]]; then
  command -v pi >/dev/null 2>&1 || die "set OPENCODE_API_KEY or authenticate opencode-go in Pi"
  opencode_go_token=$(pi auth print-api-key --provider opencode-go) ||
    die "could not read the opencode-go credential from Pi"
fi
[[ -n "$opencode_go_token" ]] || die "the opencode-go credential is empty"

ocr_session_id="ocr-$(date +%s)-$$"

OCR_LLM_TOKEN="$opencode_go_token" \
OCR_LLM_URL="https://opencode.ai/inference/go/v1/chat/completions" \
OCR_LLM_MODEL="$ocr_model" \
OCR_LLM_PROTOCOL="openai" \
OCR_USE_ANTHROPIC="false" \
OCR_LLM_EXTRA_HEADERS="x-opencode-session=$ocr_session_id" \
ocr "$@"
