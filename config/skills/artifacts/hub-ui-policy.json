{
  "fonts": [
    "system-ui",
    "-apple-system",
    "Segoe UI",
    "Roboto",
    "sans-serif",
    "ui-monospace",
    "SFMono-Regular",
    "Menlo",
    "monospace"
  ],
  "fontSizes": [
    12,
    14,
    16,
    20,
    24
  ],
  "typeRules": [
    {
      "selector": "h1",
      "sizes": [
        24
      ]
    },
    {
      "selector": "h2",
      "sizes": [
        20,
        24
      ]
    },
    {
      "selector": "h3",
      "sizes": [
        20,
        24
      ]
    },
    {
      "selector": "button, [role=button]",
      "sizes": [
        14,
        16
      ]
    }
  ],
  "minControlSize": 15,
  "controlSizeRules": [],
  "minControlGap": 8,
  "minControlInset": 8,
  "controlContainers": [
    "[data-ui-container]"
  ],
  "minLayoutGap": 8,
  "bannedCopy": [
    "unlock your potential",
    "seamlessly",
    "game-changing"
  ],
  "viewports": [
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 1440,
      "height": 900
    }
  ],
  "colorSchemes": [
    "light",
    "dark"
  ],
  "exceptions": [
    {
      "selector": ".t .short",
      "rules": [
        "content-clipping"
      ],
      "reason": "User asked (2026-10-12) for page and app titles on one line cut with an ellipsis; the full title opens in a panel on hover."
    },
    {
      "selector": ".addr .short",
      "rules": [
        "content-clipping"
      ],
      "reason": "User asked (2026-10-12) for addresses on one line cut with an ellipsis; the full address opens in a panel on hover."
    },
    {
      "selector": ".desc .short",
      "rules": [
        "content-clipping"
      ],
      "reason": "User asked (2026-10-12) for descriptions cut at two lines with an ellipsis; the full text opens in a panel on hover."
    },
    {
      "selector": ".cmd .short",
      "rules": [
        "content-clipping"
      ],
      "reason": "User asked (2026-10-12) for app commands on one line with an ellipsis; the full command opens in a panel on hover."
    },
    {
      "selector": ".trig",
      "rules": [
        "icon-button-tooltip"
      ],
      "reason": "The command button opens a panel with the command and its copy button on hover and keyboard focus; that panel is its label, so a tooltip would sit on top of it."
    }
  ]
}
