{
  "description": "Portable Workmux lifecycle hooks and repository command dispatch.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status waiting || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux register-agent || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status done || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=\"${CODEX_HOME:-$HOME/.codex}/bin/codex-command-dispatch.mjs\"; [ -f \"$script\" ] || script=\"$HOME/.codex/bin/codex-command-dispatch.mjs\"; node \"$script\"",
            "statusMessage": "Loading repository command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ]
  }
}
